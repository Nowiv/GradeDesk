<?xml version="1.0" encoding="UTF-8"?>

<!--
  Grundgerüst: Seitenleiste links, Arbeitsfläche rechts.
  Die Navigationseinträge und der Sprachumschalter entstehen zur Laufzeit,
  damit eine zusätzliche Ansicht keinen Eingriff in diese Datei braucht.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ch.gradedesk.ui.MainController"
            styleClass="app-shell">

    <top>
        <MenuBar styleClass="app-menu">
            <menus>
                <Menu fx:id="helpMenu" text="%menu.help">
                    <items>
                        <MenuItem fx:id="checkUpdatesMenuItem" text="%menu.checkUpdates" onAction="#checkForUpdates"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
      <HBox styleClass="sidebar-dock">
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar__brand">
                <HBox styleClass="sidebar__wordmark">
                    <Label fx:id="wordmarkPrefixLabel" styleClass="sidebar__wordmark-prefix"/>
                    <Label fx:id="wordmarkSuffixLabel" styleClass="sidebar__wordmark-suffix"/>
                </HBox>
                <Label fx:id="taglineLabel" styleClass="sidebar__tagline"/>
            </VBox>

            <VBox fx:id="navigationBox" styleClass="sidebar__nav"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox fx:id="sidebarFooter" styleClass="sidebar__footer">
                <Label fx:id="saveStatusLabel" styleClass="save-status"/>
                <Label fx:id="locationLabel" styleClass="sidebar__path"/>
                <Label fx:id="languageLabel" styleClass="sidebar__section-label"/>
            </VBox>
        </VBox>
      </HBox>
    </left>

    <center>
        <VBox styleClass="content">
            <HBox fx:id="alertBanner" managed="false" styleClass="banner,banner--warning"
                  visible="false">
                <Label fx:id="alertBannerLabel" styleClass="banner__text" HBox.hgrow="ALWAYS"/>
                <VBox.margin>
                    <Insets top="20.0" right="32.0" bottom="0.0" left="32.0"/>
                </VBox.margin>
            </HBox>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

</BorderPane>
