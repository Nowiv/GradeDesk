<?xml version="1.0" encoding="UTF-8"?>

<!-- Säulendiagramm aller Modulnoten, gruppiert nach Semester. -->

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox styleClass="page-header">
            <VBox styleClass="page-header__text" HBox.hgrow="ALWAYS">
                <Label styleClass="page-title" text="%chart.title"/>
                <Label styleClass="page-subtitle" text="%chart.subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-body">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <StackPane fx:id="chartHolder" VBox.vgrow="ALWAYS"/>
                <HBox fx:id="legendBox" styleClass="chart-legend-bar"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
